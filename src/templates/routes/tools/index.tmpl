{{define "tools"}}
<main class="flex flex-col items-center">
    <!-- Timeline filter: plain links, swapped in place by folio -->
    <nav class="flex flex-col items-center self-stretch gap-2" data-folio-link>
        <ul class="flex py-2 justify-center items-center self-stretch gap-2">
            {{ range .Model.Periods }}
            <li{{ if eq .Key $.Model.Current.Key }} class="uk-active"{{ end }}>
                <a href="/tools?period={{ .Key }}"
                   class="uk-btn {{ if eq .Key $.Model.Current.Key }}bg-primary-glow text-zinc-900{{ else }}uk-btn-default{{ end }}"
                   {{ if eq .Key $.Model.Current.Key }}aria-current="page"{{ end }}>{{ .Label }}</a>
            </li>
            {{ end }}
        </ul>
    </nav>
    <section class="flex flex-col pt-20 pb-64 justify-center items-center gap-12 self-stretch flex-1">
        <section class="flex flex-col py-2 px-20 justify-center items-center gap-32 self-stretch flex-1">
            <headline class="flex flex-col gap-4 py-4 justify-center items-center w-full">
                <h1 class="uk-h1 playfair">Mood History</h1>
                <h2 class="uk-h2 mood-period-title">{{ .Model.Current.Title }}</h2>
            </headline>

            <div class="moods-container flex flex-col w-full gap-12">
                {{ range .Model.Moods }}
                <action-center>
                    <headline class="flex py-16 justify-center items-center">
                        <h1 class="uk-h1 playfair">Your Mood: "{{ .MoodText }}"</h1>
                    </headline>
                    <div class="flex items-center justify-center gap-2 self-stretch">
                        {{ if .Playlist }}
                        <a href="/mood/{{ .ID }}" data-folio-link class="uk-btn bg-primary-glow flex-1 text-zinc-900">View Playlist</a>
                        {{ else }}
                        <form method="POST" action="/mood/{{ .ID }}" data-folio-form class="flex flex-1">
                            <button type="submit" class="uk-btn bg-primary-glow flex-1 text-zinc-900">Generate Playlist</button>
                        </form>
                        {{ end }}
                    </div>
                </action-center>
                {{ else }}
                <p class="text-center py-8">No moods recorded for this period</p>
                {{ end }}
            </div>
        </section>
    </section>
</main>
{{end}}
